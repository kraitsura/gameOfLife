# Application
APP_NAME=game-of-life-simulation
ENVIRONMENT=development

# Docker Registry
DOCKER_REGISTRY=your-registry
TAG=latest

# Domain Configuration
DOMAIN=localhost

# Frontend URLs
VITE_URL=http://localhost:5173/
VITE_WS_URL=ws://localhost:8000/ws/simulation

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS Origins - For Docker (JSON format for Python's json.loads)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]'
DATABASE_URL=sqlite:///./data/simulation.db
DEBUG=true

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30

# WebSocket Header Limits (for websockets library v15.0+)
# These environment variables configure the websockets library's security limits.
#
# WEBSOCKETS_MAX_LINE_LENGTH: Maximum bytes per HTTP header line (default: 8192)
# - Increased to 32768 (32KB) to handle:
#   - Large authentication cookies (JWT tokens, OAuth verifiers)
#   - Browser extensions that inject tracking/debugging headers
#   - Development cookies from other localhost projects (e.g., Supabase auth)
# - Production-safe: Modern web servers use 8-16KB limits, 32KB is reasonable
#
# WEBSOCKETS_MAX_NUM_HEADERS: Maximum number of HTTP header fields (default: 128)
# - Increased to 256 to accommodate verbose browser/extension headers
#
# Note: In development, Chrome may send large cookies from other localhost projects.
# If WebSocket connections fail with "400 Bad Request", check browser cookies.
# See docs/DEVELOPMENT.md for troubleshooting.
WEBSOCKETS_MAX_LINE_LENGTH=32768
WEBSOCKETS_MAX_NUM_HEADERS=256

# Simulation Configuration
SIMULATION_FPS=60
WORLD_WIDTH=800
WORLD_HEIGHT=600

# Logging
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Development Scaling
FRONTEND_REPLICAS=1
MAX_WORKERS=1