# Application
APP_NAME=game-of-life-simulation
ENVIRONMENT=development

# Docker Registry
DOCKER_REGISTRY=your-registry
TAG=latest

# Domain Configuration
DOMAIN=localhost

# Frontend URLs
VITE_URL=http://localhost:5173/
VITE_WS_URL=ws://localhost:8000/ws/simulation

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS Origins - For Docker (JSON format for Python's json.loads)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]'
DATABASE_URL=sqlite:///./data/simulation.db
DEBUG=true

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30

# Simulation Configuration
SIMULATION_FPS=60
WORLD_WIDTH=800
WORLD_HEIGHT=600

# Logging
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Development Scaling
FRONTEND_REPLICAS=1
MAX_WORKERS=1