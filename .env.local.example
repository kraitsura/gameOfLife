# .env.local.example
# Copy this file to .env.local and customize for your local development
# .env.local is gitignored and will override settings from .env.development

# Uncomment and modify as needed for your local setup

# Debug mode
# DEBUG=true

# Custom CORS origins (if you need additional origins)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.1.100:3000

# Custom database path
# DATABASE_URL=sqlite:///./data/dev.db

# WebSocket heartbeat interval (seconds)
# WS_HEARTBEAT_INTERVAL=30

# Simulation settings
# SIMULATION_FPS=60
# WORLD_WIDTH=1000
# WORLD_HEIGHT=1000

# Logging level
# LOG_LEVEL=DEBUG

# Custom backend port (if not using 8000)
# BACKEND_PORT=8000
